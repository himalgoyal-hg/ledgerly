# Copy to `.env` on the server (next to docker-compose.yml) and fill in.
# Generate each secret with:  openssl rand -hex 32

# Domain pointing at this server (A record) — Caddy fetches HTTPS for it.
DOMAIN=books.example.com

# Postgres password — letters and digits only (it is embedded in a URL).
POSTGRES_PASSWORD=
# iron-session cookie encryption, 32+ characters. NOT the local dev value.
SESSION_SECRET=
# Bearer token for the daily /api/automation/run call.
CRON_SECRET=

# Only used when seeding an EMPTY database. Not needed when restoring a backup.
SEED_ADMIN_PASSWORD=
SEED_MEMBER_PASSWORD=

# Optional — AI tagging / PDF reading.
ANTHROPIC_API_KEY=

# Optional — reminder and weekly-summary emails. Without these, messages queue.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
