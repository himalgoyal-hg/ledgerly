DATABASE_URL="postgresql://user:password@host:5432/ledgerly"
# Optional: direct (unpooled) URL for migrations when DATABASE_URL goes through a pooler (Neon sets both).
DATABASE_URL_UNPOOLED=""
SESSION_SECRET="<random 32+ character string>"
SEED_ADMIN_PASSWORD="<initial admin password>"
SEED_MEMBER_PASSWORD="<initial member password>"
# Bearer token for the daily /api/automation/run call (Vercel Cron sends it automatically).
CRON_SECRET=""
# Set on Vercel by the Blob store; when present, documents go to Vercel Blob instead of ./uploads.
BLOB_READ_WRITE_TOKEN=""
# Optional — AI tagging / PDF reading.
ANTHROPIC_API_KEY=""
# Optional — reminder and weekly-summary emails.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
