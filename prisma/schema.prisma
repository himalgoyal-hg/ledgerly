// Ledgerly — Phases 1–2 schema
// Phase 1: users & single-admin model, permission matrix, entities, bank
//          accounts, cash locations, audit log, soft-delete/archive framework.
// Phase 2: accounting engine — Chart of Accounts, double-entry journal,
//          reversal-based edit/delete/undo, period locks.
//
// Invariants enforced in DB (see migrations):
//   - At most one ADMIN user (partial unique index)
//   - Every journal entry balances: total Dr = total Cr (deferred trigger)
//   - Journal lines are append-only; entries cannot be deleted or have
//     their financial fields updated (triggers)
//   - No posting into a locked period (trigger)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum EntityType {
  INDIVIDUAL
  PVT_LTD
  PARTNERSHIP
  LLP
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(MEMBER)
  isActive     Boolean   @default(true)
  // If true, this member only sees entities listed in entityScopes.
  entityScoped Boolean   @default(false)
  deletedAt    DateTime?

  permissions  MemberPermission?
  entityScopes UserEntityScope[]
  auditLogs    AuditLog[]        @relation("actor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per member. Admin bypasses this entirely (holds every permission).
// Members start with ZERO permissions except reimbursementSubmit (spec §1.1).
model MemberPermission {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  statementUpload       Boolean @default(false) // Statement upload & import
  transactionTagging    Boolean @default(false) // Tagging queue work
  transactionEditDelete Boolean @default(false) // Transaction edit / delete / undo
  viewFinancialReports  Boolean @default(false) // P&L / Balance Sheet
  viewTaxRegisters      Boolean @default(false) // GST / TDS registers
  cashEntries           Boolean @default(false) // Cash entry form
  viewCashReports       Boolean @default(false) // Cash reports
  reimbursementSubmit   Boolean @default(true)  // Submit own reimbursements

  updatedAt DateTime @updatedAt
}

model UserEntityScope {
  userId   String
  entityId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([userId, entityId])
}

model Entity {
  id           String     @id @default(cuid())
  name         String
  code         String     @unique // HG / MG / PG / ACPL / ...
  type         EntityType
  pan          String
  gstin        String?
  fyStartMonth Int        @default(4) // April
  archivedAt   DateTime? // archive = soft remove (spec §2.1)

  bankAccounts   BankAccount[]
  cashLocations  CashLocation[]
  userScopes     UserEntityScope[]
  ledgerAccounts LedgerAccount[]
  journalDocs    JournalDoc[]
  journalEntries JournalEntry[]
  periodLocks    PeriodLock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BankAccount {
  id             String    @id @default(cuid())
  entityId       String
  entity         Entity    @relation(fields: [entityId], references: [id])
  bankName       String
  accountNumber  String
  ifsc           String
  nickname       String // "HG ICICI", "ACPL 7838"
  openingBalance Decimal   @db.Decimal(14, 2)
  openingDate    DateTime  @db.Date
  archivedAt     DateTime?

  // Phase 2 wires this to the auto-created Chart of Accounts ledger account.
  ledgerAccountId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, accountNumber])
}

model CashLocation {
  id         String    @id @default(cuid())
  entityId   String
  entity     Entity    @relation(fields: [entityId], references: [id])
  name       String // Office Drawer, Locker, Car, With Mom, ...
  archivedAt DateTime?

  // Phase 2 wires this to its Chart of Accounts ledger account.
  ledgerAccountId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, name])
}

// ---------------------------------------------------------------------------
// Phase 2 — Accounting engine
// ---------------------------------------------------------------------------

enum AccountKind {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

// Chart of Accounts, per entity, auto-seeded on entity creation (spec §4).
// Group accounts structure the tree and cannot be posted to; system accounts
// are seeded and cannot be archived.
model LedgerAccount {
  id       String      @id @default(cuid())
  entityId String
  entity   Entity      @relation(fields: [entityId], references: [id])
  code     String // "1000", "1101", ... unique per entity, sorts the tree
  name     String
  kind     AccountKind
  parentId String?
  parent   LedgerAccount?  @relation("tree", fields: [parentId], references: [id])
  children LedgerAccount[] @relation("tree")
  isGroup  Boolean         @default(false)
  system   Boolean         @default(false)
  archivedAt DateTime?

  lines JournalLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, code])
  @@index([entityId, kind])
}

enum EntryKind {
  FORWARD // a version of the record's content
  REVERSAL // exact negation of a forward entry (edit/delete mechanics, §5)
}

enum EntryState {
  ACTIVE // current version of its document
  REVERSED // superseded by an edit, or deleted — its reversal exists
}

// A logical, user-visible record ("one clean edited record", spec §5).
// The ledger truth is its append-only entries; this header only tracks
// which forward entry is current. currentEntryId = null ⇒ deleted (in bin).
model JournalDoc {
  id         String  @id @default(cuid())
  entityId   String
  entity     Entity  @relation(fields: [entityId], references: [id])
  sourceType String // "manual" | "opening_balance" | (Phase 3+: "statement_txn", ...)
  sourceId   String?
  currentEntryId String?   @unique
  currentEntry   JournalEntry? @relation("current", fields: [currentEntryId], references: [id])
  deletedAt   DateTime?
  deletedById String?

  entries JournalEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityId, deletedAt])
  @@index([sourceType, sourceId])
}

// One balanced double-entry posting. Append-only: never updated (except
// state bookkeeping) and never deleted — edits/deletes post REVERSALs.
model JournalEntry {
  id        String     @id @default(cuid())
  entityId  String
  entity    Entity     @relation(fields: [entityId], references: [id])
  docId     String
  doc       JournalDoc @relation(fields: [docId], references: [id])
  version   Int // 1, 2, 3... within the doc (REVERSALs carry their target's version)
  kind      EntryKind
  state     EntryState @default(ACTIVE)
  date      DateTime   @db.Date
  narration String
  reference String?
  // For REVERSAL entries: which forward entry this negates.
  reversesId String?       @unique
  reverses   JournalEntry? @relation("reversal", fields: [reversesId], references: [id])
  reversedBy JournalEntry? @relation("reversal")
  // Why this entry exists: "create" | "edit" | "delete" | "undo_delete" | "undo_edit"
  action String

  currentOf JournalDoc? @relation("current")

  createdById String
  createdAt   DateTime @default(now())

  lines JournalLine[]

  @@index([entityId, date])
  @@index([docId])
}

// Exactly one of debit/credit is positive (CHECK in migration).
model JournalLine {
  id        String        @id @default(cuid())
  entryId   String
  entry     JournalEntry  @relation(fields: [entryId], references: [id])
  accountId String
  account   LedgerAccount @relation(fields: [accountId], references: [id])
  debit     Decimal       @default(0) @db.Decimal(14, 2)
  credit    Decimal       @default(0) @db.Decimal(14, 2)
  memo      String?

  @@index([accountId])
  @@index([entryId])
}

// Admin locks a month after GST filing (spec §4): locked months reject
// posting, edit, delete and undo. Unlock is admin-only and audit-logged.
model PeriodLock {
  id         String   @id @default(cuid())
  entityId   String
  entity     Entity   @relation(fields: [entityId], references: [id])
  year       Int
  month      Int // 1–12
  lockedById String
  lockedAt   DateTime @default(now())

  @@unique([entityId, year, month])
}

// Append-only audit trail: who, when, what, before → after (spec §1.1, §5).
model AuditLog {
  id         String  @id @default(cuid())
  actorId    String?
  actor      User?   @relation("actor", fields: [actorId], references: [id])
  action     String // "user.create" | "permission.update" | "entity.archive" | ...
  targetType String // "User" | "Entity" | "BankAccount" | ...
  targetId   String
  summary    String
  before     Json?
  after      Json?

  createdAt DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
  @@index([createdAt])
}
