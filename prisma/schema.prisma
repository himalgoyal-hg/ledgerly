// Ledgerly — Phases 1–5 schema
// Phase 1: users & single-admin model, permission matrix, entities, bank
//          accounts, cash locations, audit log, soft-delete/archive framework.
// Phase 2: accounting engine — Chart of Accounts, double-entry journal,
//          reversal-based edit/delete/undo, period locks.
// Phase 3: statement pipeline — imports, statement transactions, tagging
//          queue, rules + learning engine, cost centres.
// Phase 4: operations — reimbursements, cash entries, bills, salary register,
//          finance tasks, invoices. Thin records over posting rules.
// Phase 5: taxation — GST/TDS fields with split-posting, TaxLine register
//          rows feeding GSTR-1 / GSTR-3B / TDS registers.
// Phase 6: reports — every statement is a live query over the ledger; only
//          budget targets are stored (nothing else is derived data).
// Phase 7: automation — payment-source preferences, recurring generation,
//          reminders and the weekly summary, all driven by one cron entry.
//
// Invariants enforced in DB (see migrations):
//   - At most one ADMIN user (partial unique index)
//   - Every journal entry balances: total Dr = total Cr (deferred trigger)
//   - Journal lines are append-only; entries cannot be deleted or have
//     their financial fields updated (triggers)
//   - No posting into a locked period (trigger)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum EntityType {
  INDIVIDUAL
  PVT_LTD
  PARTNERSHIP
  LLP
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(MEMBER)
  isActive     Boolean   @default(true)
  // If true, this member only sees entities listed in entityScopes.
  entityScoped Boolean   @default(false)
  deletedAt    DateTime?

  permissions  MemberPermission?
  entityScopes UserEntityScope[]
  auditLogs    AuditLog[]        @relation("actor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per member. Admin bypasses this entirely (holds every permission).
// Members start with ZERO permissions except reimbursementSubmit (spec §1.1).
model MemberPermission {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  statementUpload       Boolean @default(false) // Statement upload & import
  transactionTagging    Boolean @default(false) // Tagging queue work
  transactionEditDelete Boolean @default(false) // Transaction edit / delete / undo
  viewFinancialReports  Boolean @default(false) // P&L / Balance Sheet
  viewTaxRegisters      Boolean @default(false) // GST / TDS registers
  cashEntries           Boolean @default(false) // Cash entry form
  viewCashReports       Boolean @default(false) // Cash reports
  reimbursementSubmit   Boolean @default(true)  // Submit own reimbursements

  updatedAt DateTime @updatedAt
}

model UserEntityScope {
  userId   String
  entityId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([userId, entityId])
}

model Entity {
  id           String     @id @default(cuid())
  name         String
  code         String     @unique // HG / MG / PG / ACPL / ...
  type         EntityType
  pan          String
  gstin        String?
  fyStartMonth Int        @default(4) // April
  archivedAt   DateTime? // archive = soft remove (spec §2.1)

  // Invoice auto-numbering (spec §6.6): "INV-0001", counter per entity.
  invoicePrefix     String @default("INV")
  nextInvoiceNumber Int    @default(1)

  bankAccounts   BankAccount[]
  cashLocations  CashLocation[]
  userScopes     UserEntityScope[]
  ledgerAccounts LedgerAccount[]
  journalDocs    JournalDoc[]
  journalEntries JournalEntry[]
  periodLocks    PeriodLock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BankAccount {
  id             String    @id @default(cuid())
  entityId       String
  entity         Entity    @relation(fields: [entityId], references: [id])
  bankName       String
  accountNumber  String
  ifsc           String
  nickname       String // "HG ICICI", "ACPL 7838"
  openingBalance Decimal   @db.Decimal(14, 2)
  openingDate    DateTime  @db.Date
  archivedAt     DateTime?

  // Auto-created Chart of Accounts ledger account (Phase 2).
  ledgerAccountId String?

  imports StatementImport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, accountNumber])
}

model CashLocation {
  id         String    @id @default(cuid())
  entityId   String
  entity     Entity    @relation(fields: [entityId], references: [id])
  name       String // Office Drawer, Locker, Car, With Mom, ...
  archivedAt DateTime?

  // Phase 2 wires this to its Chart of Accounts ledger account.
  ledgerAccountId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, name])
}

// ---------------------------------------------------------------------------
// Phase 2 — Accounting engine
// ---------------------------------------------------------------------------

enum AccountKind {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

// Chart of Accounts, per entity, auto-seeded on entity creation (spec §4).
// Group accounts structure the tree and cannot be posted to; system accounts
// are seeded and cannot be archived.
model LedgerAccount {
  id       String      @id @default(cuid())
  entityId String
  entity   Entity      @relation(fields: [entityId], references: [id])
  code     String // "1000", "1101", ... unique per entity, sorts the tree
  name     String
  kind     AccountKind
  parentId String?
  parent   LedgerAccount?  @relation("tree", fields: [parentId], references: [id])
  children LedgerAccount[] @relation("tree")
  isGroup  Boolean         @default(false)
  system   Boolean         @default(false)
  archivedAt DateTime?

  lines JournalLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, code])
  @@index([entityId, kind])
}

enum EntryKind {
  FORWARD // a version of the record's content
  REVERSAL // exact negation of a forward entry (edit/delete mechanics, §5)
}

enum EntryState {
  ACTIVE // current version of its document
  REVERSED // superseded by an edit, or deleted — its reversal exists
}

// A logical, user-visible record ("one clean edited record", spec §5).
// The ledger truth is its append-only entries; this header only tracks
// which forward entry is current. currentEntryId = null ⇒ deleted (in bin).
model JournalDoc {
  id         String  @id @default(cuid())
  entityId   String
  entity     Entity  @relation(fields: [entityId], references: [id])
  sourceType String // "manual" | "opening_balance" | (Phase 3+: "statement_txn", ...)
  sourceId   String?
  currentEntryId String?   @unique
  currentEntry   JournalEntry? @relation("current", fields: [currentEntryId], references: [id])
  deletedAt   DateTime?
  deletedById String?

  entries JournalEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityId, deletedAt])
  @@index([sourceType, sourceId])
}

// One balanced double-entry posting. Append-only: never updated (except
// state bookkeeping) and never deleted — edits/deletes post REVERSALs.
model JournalEntry {
  id        String     @id @default(cuid())
  entityId  String
  entity    Entity     @relation(fields: [entityId], references: [id])
  docId     String
  doc       JournalDoc @relation(fields: [docId], references: [id])
  version   Int // 1, 2, 3... within the doc (REVERSALs carry their target's version)
  kind      EntryKind
  state     EntryState @default(ACTIVE)
  date      DateTime   @db.Date
  narration String
  reference String?
  // For REVERSAL entries: which forward entry this negates.
  reversesId String?       @unique
  reverses   JournalEntry? @relation("reversal", fields: [reversesId], references: [id])
  reversedBy JournalEntry? @relation("reversal")
  // Why this entry exists: "create" | "edit" | "delete" | "undo_delete" | "undo_edit"
  action String

  currentOf JournalDoc? @relation("current")

  createdById String
  createdAt   DateTime @default(now())

  lines JournalLine[]

  @@index([entityId, date])
  @@index([docId])
}

// Exactly one of debit/credit is positive (CHECK in migration).
model JournalLine {
  id        String        @id @default(cuid())
  entryId   String
  entry     JournalEntry  @relation(fields: [entryId], references: [id])
  accountId String
  account   LedgerAccount @relation(fields: [accountId], references: [id])
  debit     Decimal       @default(0) @db.Decimal(14, 2)
  credit    Decimal       @default(0) @db.Decimal(14, 2)
  memo      String?
  // Tier 3 of tagging (spec §3 step 5) — flows into cost centre reports.
  costCentreId String?
  costCentre   CostCentre? @relation(fields: [costCentreId], references: [id])

  @@index([accountId])
  @@index([entryId])
  @@index([costCentreId])
}

// Admin locks a month after GST filing (spec §4): locked months reject
// posting, edit, delete and undo. Unlock is admin-only and audit-logged.
model PeriodLock {
  id         String   @id @default(cuid())
  entityId   String
  entity     Entity   @relation(fields: [entityId], references: [id])
  year       Int
  month      Int // 1–12
  lockedById String
  lockedAt   DateTime @default(now())

  @@unique([entityId, year, month])
}

// ---------------------------------------------------------------------------
// Phase 3 — Statement pipeline
// ---------------------------------------------------------------------------

enum ImportStatus {
  DETECTED // parsed; awaiting the confirmation banner (spec §3 step 2)
  CONFIRMED // rows are in the tagging queue / posted
}

enum TxnStatus {
  PENDING // in the tagging queue
  TAGGED // tagged (by member or system), awaiting "Post All Confirmed"
  POSTED // journal entry exists
  DUPLICATE // previously imported — kept for display, never taggable
}

model StatementImport {
  id            String       @id @default(cuid())
  // Null while unrecognized — Admin maps it once, mapping is remembered.
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  entityId      String?
  fileName      String
  status        ImportStatus @default(DETECTED)
  detectedVia   String // "account_number" | "ifsc" | "mapping" | "manual" | "unrecognized"
  // Parsed rows as extracted — source of truth for (re)materializing
  // transactions when the account is assigned or corrected.
  rawRows         Json
  headerSignature String
  // Statement's own closing balance (from the balance column's last row) —
  // must equal the ledger balance after import (spec §3 step 3).
  closingBalance Decimal? @db.Decimal(14, 2)
  rowsTotal      Int      @default(0)
  rowsDuplicate  Int      @default(0)
  uploadedById   String
  createdAt      DateTime @default(now())

  transactions StatementTransaction[]

  @@index([bankAccountId])
}

model StatementTransaction {
  id            String          @id @default(cuid())
  importId      String
  import        StatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  bankAccountId String
  entityId      String
  date          DateTime        @db.Date
  narration     String
  reference     String?
  debit         Decimal         @default(0) @db.Decimal(14, 2)
  credit        Decimal         @default(0) @db.Decimal(14, 2)
  balance       Decimal?        @db.Decimal(14, 2) // statement running balance
  // sha256(account + date + amount + narration + occurrence) — spec §3 step 3
  dedupeHash    String
  status        TxnStatus       @default(PENDING)

  // 3-tier tag (spec §3 step 5): head + nature (auto-suggested) + cost centre
  headAccountId String?
  nature        String? // expense | income | transfer_own | loan_given | loan_received | capital
  costCentreId  String?
  autoTagged    Boolean   @default(false) // "Verified by System"
  taggedById    String?
  taggedAt      DateTime?

  // Optional tax details on the tag (spec §3 step 5 / §7) — drive the
  // split-posting at post time. GST and TDS are mutually exclusive per row.
  gstType           String? // intra | inter
  gstRate           Decimal? @db.Decimal(5, 2)
  hsn               String?
  counterpartyGstin String?
  tdsSection        String? // 194C | 194J | 194I | 194H | 192
  tdsRate           Decimal? @db.Decimal(5, 2)
  deducteePan       String?

  // Once posted: the journal document underneath (sourceType "statement_txn"),
  // OR the mirror transaction whose document already carries this transfer
  // (own-account transfers post once and auto-match the mirror row, spec §3.6).
  docId       String? @unique
  mirrorTxnId String? @unique

  @@unique([bankAccountId, dedupeHash])
  @@index([entityId, status])
  @@index([importId])
}

// Rules + learning engine (spec §3 step 4). Every manual tag upserts a rule
// keyed on the narration's party token; future imports auto-tag on match.
model TagRule {
  id            String   @id @default(cuid())
  entityId      String
  pattern       String // normalized party token, e.g. "SWIGGY"
  headAccountId String
  nature        String
  costCentreId  String?
  hits          Int      @default(0)
  source        String   @default("learned") // learned | manual
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([entityId, pattern])
}

// Cost centres (spec §3 step 5 tier 3): Hyrox Project, Office Operations,
// Personal, Consultant… Admin-managed masters, per entity.
model CostCentre {
  id         String    @id @default(cuid())
  entityId   String
  name       String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  lines JournalLine[]

  @@unique([entityId, name])
}

// "Map it once; mapping is remembered" (spec §3 step 2): an unrecognized
// statement layout, once mapped by Admin, auto-routes next time.
model StatementMapping {
  id            String   @id @default(cuid())
  signature     String   @unique // sha256 of the normalized header row
  bankAccountId String
  createdById   String
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Phase 4 — Operations (spec §6). Every posting-backed record keeps its
// JournalDoc id; edit/delete/undo ride the Phase 2 reversal machinery.
// FKs to users/accounts/cost centres stay plain strings (resolved in code),
// matching the statement-pipeline convention.
// ---------------------------------------------------------------------------

enum ClaimStatus {
  PENDING // submitted, awaiting Admin review
  APPROVED // posted: Dr Expense / Cr Member Payable
  REJECTED // requires remarks; nothing posted
}

model Reimbursement {
  id       String      @id @default(cuid())
  entityId String
  memberId String // who is owed
  date     DateTime    @db.Date
  category String // member's free-text category
  amount   Decimal     @db.Decimal(14, 2)
  link     String? // bill upload (Drive link)
  remarks  String?
  status   ClaimStatus @default(PENDING)

  // Review (Admin-only): approve picks the expense head + cost centre.
  reviewedById     String?
  reviewedAt       DateTime?
  rejectReason     String?
  expenseAccountId String?
  costCentreId     String?
  docId            String?   @unique // approval posting

  createdAt DateTime @default(now())

  @@index([entityId, status])
  @@index([memberId])
}

enum CashEntryKind {
  RECEIPT // Dr Cash location / Cr head
  PAYMENT // Dr head / Cr Cash location
  TRANSFER // Dr to-location / Cr from-location
  ADJUSTMENT // either direction; mandatory reason, flagged in audit
}

model CashEntry {
  id            String        @id @default(cuid())
  entityId      String
  kind          CashEntryKind
  date          DateTime      @db.Date
  locationId    String // primary cash location
  toLocationId  String? // TRANSFER target
  headAccountId String? // RECEIPT / PAYMENT / ADJUSTMENT counter-head
  costCentreId  String?
  inflow        Boolean       @default(false) // ADJUSTMENT direction (cash increases)
  amount        Decimal       @db.Decimal(14, 2)
  remarks       String?
  reason        String? // ADJUSTMENT: mandatory
  docId         String?       @unique
  createdById   String
  createdAt     DateTime      @default(now())

  @@index([entityId, date])
}

enum BillStatus {
  PENDING // payable posted, not yet paid
  PAID
}

enum Recurrence {
  NONE
  MONTHLY
  QUARTERLY
  YEARLY
}

// Bills & insurance (spec §6.3): entry posts the payable; payment clears it.
// Recurring bills spawn the next PENDING instance when the current one is
// paid — no scheduler needed (email reminders arrive with Phase 7).
model Bill {
  id               String     @id @default(cuid())
  entityId         String
  vendor           String
  billType         String // Electricity, Insurance, Rent, ...
  amount           Decimal    @db.Decimal(14, 2)
  billDate         DateTime   @db.Date
  dueDate          DateTime   @db.Date
  renewalDate      DateTime?  @db.Date // insurance
  link             String? // Drive link
  remarks          String?
  recurrence       Recurrence @default(NONE)
  expenseAccountId String
  costCentreId     String?

  // Tax (spec §7): amount above is the TAXABLE value. GST adds Input Credit;
  // TDS withholds from the vendor. Payable = amount + gstAmount − tdsAmount.
  gstType     String? // intra | inter
  gstRate     Decimal? @db.Decimal(5, 2)
  hsn         String?
  vendorGstin String?
  gstAmount   Decimal  @default(0) @db.Decimal(14, 2)
  tdsSection  String?
  tdsRate     Decimal? @db.Decimal(5, 2)
  vendorPan   String?
  tdsAmount   Decimal  @default(0) @db.Decimal(14, 2)

  status           BillStatus @default(PENDING)
  entryDocId       String?    @unique // Dr Expense / Cr Vendor payable
  paymentDocId     String?    @unique // Dr Vendor payable / Cr Bank-Cash
  paidAt           DateTime?
  seriesId         String? // recurring chain root
  periodKey        String? // "2026-08" — one instance per period
  createdById      String
  createdAt        DateTime   @default(now())

  @@unique([seriesId, periodKey])
  @@index([entityId, status, dueDate])
}

enum PayrollType {
  SALARY // TDS u/s 192
  CONSULTANT // TDS u/s 194J
}

model SalaryPerson {
  id                String      @id @default(cuid())
  entityId          String
  name              String
  type              PayrollType
  team              String?
  costCentreId      String?
  monthlyGross      Decimal     @db.Decimal(14, 2)
  tdsSection        String // "192" | "194J"
  tdsRate           Decimal     @db.Decimal(5, 2) // %
  payableAccountId  String? // per-person payable under 2400
  archivedAt        DateTime?
  createdAt         DateTime    @default(now())

  @@unique([entityId, name])
}

enum RunStatus {
  DRAFT // HR fills variables
  APPROVED // consolidated posting exists; payables + TDS payable live
  PAID // mark-paid run posted
}

// Monthly run (spec §6.4): draft → Admin approves (consolidated posting:
// Dr expense by cost centre / Cr per-person payables + Cr TDS Payable) →
// mark-paid (Dr payables / Cr Bank) → TDS deposit becomes a Finance Task.
model SalaryRun {
  id           String    @id @default(cuid())
  entityId     String
  year         Int
  month        Int // 1–12
  status       RunStatus @default(DRAFT)
  docId        String?   @unique
  paymentDocId String?   @unique
  approvedById String?
  createdById  String
  createdAt    DateTime  @default(now())

  lines SalaryRunLine[]

  @@unique([entityId, year, month])
}

model SalaryRunLine {
  id           String    @id @default(cuid())
  runId        String
  run          SalaryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  personId     String
  gross        Decimal   @db.Decimal(14, 2)
  tds          Decimal   @db.Decimal(14, 2)
  net          Decimal   @db.Decimal(14, 2)
  costCentreId String?

  @@unique([runId, personId])
}

enum TaskStatus {
  OPEN
  DONE
}

// Finance tasks (spec §6.5): EMI, subscriptions, payroll, GST/TDS payments,
// renewals. Completing a recurring task spawns the next instance.
model FinanceTask {
  id            String     @id @default(cuid())
  entityId      String
  title         String
  kind          String // emi | subscription | payroll | gst | tds | renewal | other
  amount        Decimal?   @db.Decimal(14, 2)
  dueDate       DateTime   @db.Date
  recurrence    Recurrence @default(NONE)
  status        TaskStatus @default(OPEN)
  completedAt   DateTime?
  completedById String?
  notes         String?
  seriesId      String?
  periodKey     String?
  createdById   String
  createdAt     DateTime   @default(now())

  @@unique([seriesId, periodKey])
  @@index([entityId, status, dueDate])
}

enum InvoiceStatus {
  OPEN
  PARTIAL // some payment received
  SETTLED // fully paid — archive
}

model Invoice {
  id              String        @id @default(cuid())
  entityId        String
  number          String // auto: prefix + zero-padded counter
  customer        String
  date            DateTime      @db.Date
  dueDate         DateTime      @db.Date
  amount          Decimal       @db.Decimal(14, 2) // invoice TOTAL (incl. GST)
  narration       String?
  incomeAccountId String
  costCentreId    String?
  debtorAccountId String // per-customer account under Sundry Debtors (1300)

  // GST (spec §7.1): amount = taxable + gstAmount; Cr Output Liability.
  gstType       String? // intra | inter
  gstRate       Decimal? @db.Decimal(5, 2)
  hsn           String?
  customerGstin String?
  gstAmount     Decimal  @default(0) @db.Decimal(14, 2)
  status          InvoiceStatus @default(OPEN)
  docId           String?       @unique // Dr Debtor / Cr Income
  createdById     String
  createdAt       DateTime      @default(now())

  payments InvoicePayment[]

  @@unique([entityId, number])
  @@index([entityId, status])
}

model InvoicePayment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  amount      Decimal  @db.Decimal(14, 2)
  docId       String?  @unique // Dr Bank-Cash / Cr Debtor
  createdById String
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Phase 5 — Taxation (spec §7). One register row per tax-bearing posting,
// keyed by its JournalDoc: the ledger carries the money (2210 Output /
// 1500 Input Credit / 2230 TDS Payable); TaxLine carries the register
// metadata (GSTIN, HSN, rate, section, deductee) for GSTR-1/3B and the TDS
// register. Register queries exclude deleted docs.
// ---------------------------------------------------------------------------

model TaxLine {
  id       String   @id @default(cuid())
  entityId String
  docId    String   @unique
  date     DateTime @db.Date
  // "output": outward supply (GSTR-1). "input": purchases / expenses (ITC, TDS).
  direction String
  party     String?

  gstType           String?
  gstRate           Decimal? @db.Decimal(5, 2)
  hsn               String?
  counterpartyGstin String?
  taxableValue      Decimal  @db.Decimal(14, 2)
  gstAmount         Decimal  @default(0) @db.Decimal(14, 2)

  tdsSection  String?
  tdsRate     Decimal? @db.Decimal(5, 2)
  deducteePan String?
  tdsAmount   Decimal  @default(0) @db.Decimal(14, 2)

  sourceType String // invoice | bill | statement_txn | salary_run
  sourceId   String
  createdAt  DateTime @default(now())

  @@index([entityId, date])
}

// ---------------------------------------------------------------------------
// Phase 6 — Reports. P&L, Balance Sheet, Cash Flow, cost centre and party
// reports are all live queries over the journal (spec §3 step 7, §10) —
// nothing is stored. Budget targets are the one exception: they are an
// input, not derived data.
// ---------------------------------------------------------------------------

model Budget {
  id        String   @id @default(cuid())
  entityId  String
  accountId String
  year      Int
  month     Int // 1–12
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, accountId, year, month])
  @@index([entityId, year])
}

// ---------------------------------------------------------------------------
// Phase 7 — Smart suggestions & automation (spec §8, §6.5, §10)
// ---------------------------------------------------------------------------

// "Entity/purpose mapping" (spec §8.1): which account normally pays for
// what. purpose is "default", a task kind ("emi"/"gst"/"tds"/"payroll"),
// a module ("salary"/"reimbursement"/"invoice_receipt"), or a specific
// expense head ("head:<ledgerAccountId>").
model PaymentPreference {
  id              String   @id @default(cuid())
  entityId        String
  purpose         String
  ledgerAccountId String // the bank / cash ledger account that normally pays
  priority        Int      @default(0) // lower wins among equal matches
  createdAt       DateTime @default(now())

  @@unique([entityId, purpose, ledgerAccountId])
  @@index([entityId])
}

enum NotifyStatus {
  QUEUED // rendered and stored; no transport configured yet
  SENT
  FAILED
}

// Reminder / weekly-summary outbox (spec §6.5, §10). Messages are rendered
// and stored first, then delivered — so a missing SMTP config loses nothing
// and re-running the job never double-sends (dedupeKey is unique).
model NotificationOutbox {
  id        String       @id @default(cuid())
  entityId  String
  kind      String // weekly_summary | due_reminder | low_balance
  channel   String // email | whatsapp
  recipient String
  subject   String
  body      String
  status    NotifyStatus @default(QUEUED)
  dedupeKey String       @unique
  error     String?
  sentAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([entityId, kind, createdAt])
}

// Append-only audit trail: who, when, what, before → after (spec §1.1, §5).
model AuditLog {
  id         String  @id @default(cuid())
  actorId    String?
  actor      User?   @relation("actor", fields: [actorId], references: [id])
  action     String // "user.create" | "permission.update" | "entity.archive" | ...
  targetType String // "User" | "Entity" | "BankAccount" | ...
  targetId   String
  summary    String
  before     Json?
  after      Json?

  createdAt DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
  @@index([createdAt])
}
